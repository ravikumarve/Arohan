{
  "name": "arohan",
  "version": "1.0.0",
  "private": true,
  "description": "AROHAN — Voice-Native Mass Screening Mesh for Bharat",
  "workspaces": [
    "frontend",
    "console",
    "admin",
    "recruiter",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=console\" \"npm run dev --workspace=admin\" \"npm run dev --workspace=recruiter\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:console": "npm run dev --workspace=console",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:recruiter": "npm run dev --workspace=recruiter",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=frontend",
    "build:console": "npm run build --workspace=console",
    "build:admin": "npm run build --workspace=admin",
    "build:recruiter": "npm run build --workspace=recruiter",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:all": "npm run lint --workspaces --if-present",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "test": "pytest tests/ -v",
    "start": "npm run start --workspace=frontend"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.4",
    "typescript": "^5.0.0"
  }
}
