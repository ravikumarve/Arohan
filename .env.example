# =============================================================================
# AROHAN — Environment Variables Template
# Copy to .env or config/.env and fill in secrets before running.
# See src/config/settings.py for defaults and descriptions.
# =============================================================================

# --- Application ---
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4

# --- Database (PostgreSQL) ---
POSTGRES_USER=arohan
POSTGRES_PASSWORD=arohan_dev     # CHANGE IN PRODUCTION
POSTGRES_DB=arohan
DATABASE_URL=postgresql+asyncpg://arohan:arohan_dev@localhost:5432/arohan

# --- Redis (Session / Cache / Celery backend) ---
REDIS_PASSWORD=redis_dev         # CHANGE IN PRODUCTION
REDIS_URL=redis://:redis_dev@localhost:6379/0

# --- RabbitMQ (Celery broker) ---
RABBITMQ_USER=arohan
RABBITMQ_PASSWORD=rabbitmq_dev   # CHANGE IN PRODUCTION
RABBITMQ_VHOST=/arohan
RABBITMQ_URL=amqp://arohan:rabbitmq_dev@localhost:5672//arohan
CELERY_BROKER_URL=amqp://arohan:rabbitmq_dev@localhost:5672//arohan
CELERY_RESULT_BACKEND=redis://:redis_dev@localhost:6379/0

# --- Auth / JWT (RS256) ---
JWT_SECRET_KEY=dev_secret_change_in_production   # REQUIRED: generate with `openssl rand -hex 32` for prod
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- External: Twilio (IVR Voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- External: Meta WhatsApp Cloud API ---
META_APP_ID=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# --- External: Bhashini (STT for 22 Indian languages) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- External: OpenAI (Assessor / Matchmaker) ---
OPENAI_API_KEY=

# --- External: Pinecone (Vector store) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=arohan-candidates
PINECONE_ENVIRONMENT=us-east-1-aws

# --- Audio ---
AUDIO_MAX_DURATION_SECONDS=300
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
SUPPORTED_AUDIO_FORMATS=wav,mp3,m4a,ogg

# --- Performance / Pooling ---
CACHE_TTL_SECONDS=3600
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
REQUEST_TIMEOUT_SECONDS=30

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --- Monitoring ---
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL_SECONDS=30
ENABLE_METRICS=true
